# ── Load Required Libraries ──────────────────────────────
library(tidyverse)
library(patchwork)
library(readxl)

# ── Load Data ────────────────────────────────────────────
ST <- Stress_tolernace_indices_sandesh

# ── Define Stress Indices and Labels ─────────────────────
indices <- c("YSI","SSI","RSI","MP","YI","GMP","REI","STI","TOL","SRI",
             "MTSI1","MTSI2","HMP","GM","MRP")

index_labels <- c(
  YSI = "YSI (Yield Stability Index)",
  SSI = "SSI (Stress Susceptibility Index)",
  RSI = "RSI (Relative Stress Index)",
  MP = "MP (Mean Productivity)",
  YI = "YI (Yield Index)",
  GMP = "GMP (Geometric Mean Productivity)",
  REI = "REI (Relative Efficiency Index)",
  STI = "STI (Stress Tolerance Index)",
  TOL = "TOL (Tolerance Index)",
  SRI = "SRI (Stress Resistance Index)",
  MTSI1 = "MTSI1 (Modified Tolerance Selection Index 1)",
  MTSI2 = "MTSI2 (Modified Tolerance Selection Index 2)",
  HMP = "HMP (Harmonic Mean Productivity)",
  GM = "GM (Geometric Mean)",
  MRP = "MRP (Mean Relative Performance)"
)

# ── Reshape Data for Plotting ────────────────────────────
ST_long <- ST %>%
  pivot_longer(cols = c("Yp", "Ys"), names_to = "Condition", values_to = "Yield")

# ── Plot Function ────────────────────────────────────────
plot_regression <- function(index_name) {
  # Fit models
  model_yp <- lm(as.formula(paste0("Yp ~ `", index_name, "`")), data = ST)
  model_ys <- lm(as.formula(paste0("Ys ~ `", index_name, "`")), data = ST)
  
  # Equations
  eq_yp <- paste0("Yp: y = ", round(coef(model_yp)[2], 3), "x + ", round(coef(model_yp)[1], 1),
                  "\nR² = ", round(summary(model_yp)$r.squared, 3))
  eq_ys <- paste0("Ys: y = ", round(coef(model_ys)[2], 3), "x + ", round(coef(model_ys)[1], 1),
                  "\nR² = ", round(summary(model_ys)$r.squared, 3))
  
  # Axis ranges
  x_min <- min(ST[[index_name]], na.rm = TRUE)
  x_max <- max(ST[[index_name]], na.rm = TRUE)
  y_min <- min(c(ST$Yp, ST$Ys), na.rm = TRUE)
  y_max <- max(c(ST$Yp, ST$Ys), na.rm = TRUE)
  
  # Plot
  ggplot(ST_long, aes_string(x = index_name, y = "Yield", color = "Condition")) +
    geom_point(size = 1.5) +
    geom_smooth(method = "lm", se = FALSE, size = 0.7) +
    annotate("text", x = x_min, y = y_max, hjust = 0, vjust = 1,
             label = eq_yp, size = 4.5, face = "bold", family = "Times New Roman", color = "black") +
    annotate("text", x = x_max, y = y_min, hjust = 1, vjust = 0,
             label = eq_ys, size = 4.5, face = "bold", family = "Times New Roman", color = "black") +
    annotate("segment", x = -Inf, xend = -Inf, y = -Inf, yend = Inf,
             color = "black", size = 0.9) +
    annotate("segment", x = -Inf, xend = Inf, y = -Inf, yend = -Inf,
             color = "black", size = 0.9) +
    labs(
      x = index_labels[[index_name]],
      y = "Yp / Ys",
      color = "Environment"
    ) +
    theme_minimal(base_family = "Times New Roman") +
    theme(
      plot.title = element_blank(),
      axis.text = element_text(size = 12, face = "bold", color = "black"),
      axis.title = element_text(size = 14, face = "bold", color = "black"),
      legend.position = "bottom",
      legend.title = element_text(size = 12, family = "Times New Roman", face = "bold"),
      legend.text = element_text(size = 11, family = "Times New Roman"),
      plot.margin = margin(5, 5, 5, 5)
    )
}

# ── Generate All Plots ───────────────────────────────────
plots <- lapply(indices, plot_regression)

# ── Arrange with Vertical Spacing Between Rows ───────────
row1 <- wrap_plots(plots[1:5], ncol = 5)
row2 <- wrap_plots(plots[6:10], ncol = 5)
row3 <- wrap_plots(plots[11:15], ncol = 5)

combined_plot <- (
  row1 /
    plot_spacer() /
    row2 /
    plot_spacer() /
    row3
) +
  plot_layout(
    guides = "collect",
    heights = c(1, 0.07, 1, 0.07, 1)  # adjust 0.07 for gap size
  ) &
  theme(legend.position = "bottom")

# ── Export as TIFF ───────────────────────────────────────
ggsave(
  "sujan_final_cleaned space.tiff",
  combined_plot,
  width = 24, height = 12, dpi = 300, units = "in", device = "tiff", bg = "white"
)

# ── Display in Viewer ────────────────────────────────────
print(combined_plot)
